{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/img/*", "/logos/*", "/appIcon/*", "*.{css,js,json,ico,png,svg,woff,woff2}"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".woff": "font/woff",
    ".woff2": "font/woff2"
  }
}
